terminal_text_services=(
  'com.apple.Terminal - Open man Page in Terminal - openManPage'
  'com.apple.Terminal - Search man Page Index in Terminal - searchManPages'
)
text_services_configured=true

for text_service in "${terminal_text_services[@]}"; do
  if ! defaults write pbs NSServicesStatus -dict-add "$text_service" '{
    enabled_context_menu = 0;
    enabled_services_menu = 0;
    presentation_modes = {
      ContextMenu = 0;
      ServicesMenu = 0;
    };
  }'; then
    echo "> Failed to disable Terminal text service: $text_service" >&2
    text_services_configured=false
  fi
done

if [[ "$text_services_configured" == true ]]; then
  echo "> Terminal text services disabled. Verify with:"
  echo "  defaults read pbs NSServicesStatus"
fi

unset terminal_text_services text_service text_services_configured
