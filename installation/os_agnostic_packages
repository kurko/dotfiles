#! /bin/bash

# Installs a Python CLI, upgrading it if it's already there.
#
# This used to call `pip`, which fails twice over on macOS: Homebrew installs
# the binary as `pip3` (so `pip` is "command not found"), and its Python is
# externally managed under PEP 668, so even `pip3 install` refuses with
# "externally-managed-environment". pipx is what that error recommends, and it
# keeps each CLI in its own venv.
function pipx_install_or_update() {
  echo -n "> $1: "

  if ! command -v pipx >/dev/null 2>&1; then
    echo "skipped, pipx not installed."
    return
  fi

  if pipx list --short 2>/dev/null | grep -q "^$1 "; then
    echo "already installed, upgrading... "
    pipx upgrade "$1"
  else
    echo "installing... "
    pipx install "$1"
  fi
}

function install_os_agnostic_packages() {
  pipx_install_or_update 'files-to-prompt'

  install_ai_clis

  printf "\n"
}

# AI coding CLIs (cross-platform install scripts, no sudo needed).
function install_ai_clis() {
  echo -n "> claude code: "
  if command -v claude >/dev/null 2>&1; then
    echo "already installed."
  else
    echo "installing..."
    curl -fsSL https://claude.ai/install.sh | bash
  fi

  echo -n "> codex: "
  if command -v codex >/dev/null 2>&1; then
    echo "already installed."
  else
    echo "installing..."
    # CODEX_NON_INTERACTIVE stops the installer asking "Start Codex now?".
    # It reads that answer straight off /dev/tty, so without this it launches
    # Codex and blocks the rest of the install until you quit the TUI.
    curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh
  fi
}
